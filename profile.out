    <!-- Registration / Onboarding Modal -->
    <div
      id="authModal"
      class="relative z-50 hidden"
      aria-labelledby="modal-title"
      role="dialog"
      aria-modal="true"
    >
      <!-- Backdrop -->
      <div
        id="modalBackdrop"
        class="fixed inset-0 bg-gray-900/60 backdrop-blur-sm transition-opacity"
      ></div>

      <!-- Modal Content -->
      <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
        <div
          class="flex min-h-full items-center justify-center p-4 text-center sm:p-0"
        >
          <div
            class="relative bg-white dark:bg-gray-800 rounded-2xl text-left overflow-hidden shadow-2xl transform transition-all sm:my-8 sm:max-w-xl w-full"
          >
            <!-- Close Button -->
            <button
              id="closeModalBtn"
              class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 transition bg-gray-50 hover:bg-gray-100 rounded-full p-2"
            >
              <svg
                class="h-5 w-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M6 18L18 6M6 6l12 12"
                ></path>
              </svg>
            </button>

            <div class="px-6 py-8 sm:p-10">
              <div class="mb-8 text-center">
                <h3
                  class="text-2xl font-bold text-gray-900 dark:text-white mb-2"
                  id="modalTitle"
                >
                  Join CampusConnect
                </h3>
                <p class="text-gray-500 dark:text-gray-400" id="modalSubtitle">
                  Sign up to access trusted campus services.
                </p>

                <div
                  class="mt-4 flex justify-center bg-gray-100 p-1 rounded-full w-max mx-auto"
                >
                  <button
                    type="button"
                    id="tabSignup"
                    class="px-6 py-1.5 rounded-full text-sm font-semibold bg-white text-gray-900 shadow-sm transition"
                  >
                    Sign Up
                  </button>
                  <button
                    type="button"
                    id="tabLogin"
                    class="px-6 py-1.5 rounded-full text-sm font-semibold text-gray-500 hover:text-gray-900 transition"
                  >
                    Login
                  </button>
                </div>
              </div>

              <div
                id="authNotice"
                class="hidden mb-4 p-4 text-sm text-red-800 rounded-lg bg-red-50 border border-red-200"
                role="alert"
              ></div>
              <form id="modalForm" class="space-y-6">
                <!-- Basic Info -->
                <div class="space-y-4">
                  <div id="fullNameGroup">
                    <label
                      class="block text-sm font-semibold text-gray-700 mb-1"
                      >Full Name</label
                    >
                    <input
                      type="text"
                      id="fullName"
                      placeholder="John Doe"
                      class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none"
                      required
                    />
                  </div>
                  <div>
                    <label
                      class="block text-sm font-semibold text-gray-700 mb-1"
                      >Institutional Email</label
                    >
                    <input
                      type="email"
                      id="email"
                      placeholder="student@university.edu.ng"
                      class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none"
                      required
                    />
                  </div>
                  <div>
                    <label
                      class="block text-sm font-semibold text-gray-700 mb-1"
                      >Password</label
                    >
                    <input
                      type="password"
                      id="password"
                      placeholder="Enter your password"
                      class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none"
                      required
                    />
                  </div>
                  <div id="matricGroup">
                    <label
                      class="block text-sm font-semibold text-gray-700 mb-1"
                      >Matriculation Number</label
                    >
                    <input
                      type="text"
                      id="matricNumber"
                      placeholder="2022030200815"
                      class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none"
                      required
                    />
                  </div>

                  <div id="signupLocGroup" class="grid grid-cols-2 gap-4">
                    <div>
                      <label
                        class="block text-sm font-semibold text-gray-700 mb-1"
                        >State</label
                      >
                      <div class="relative">
                        <select
                          id="signupState"
                          class="w-full border border-gray-300 dark:border-gray-600 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none appearance-none cursor-pointer bg-white dark:bg-gray-700 text-gray-900 dark:text-white"
                        >
                          <option value="">Select State</option>
                          <option value="Abia">Abia</option>
                          <option value="Adamawa">Adamawa</option>
                          <option value="Akwa Ibom">Akwa Ibom</option>
                          <option value="Anambra">Anambra</option>
                          <option value="Bauchi">Bauchi</option>
                          <option value="Bayelsa">Bayelsa</option>
                          <option value="Benue">Benue</option>
                          <option value="Borno">Borno</option>
                          <option value="Cross River">Cross River</option>
                          <option value="Delta">Delta</option>
                          <option value="Ebonyi">Ebonyi</option>
                          <option value="Edo">Edo</option>
                          <option value="Ekiti">Ekiti</option>
                          <option value="Enugu">Enugu</option>
                          <option value="FCT - Abuja">FCT - Abuja</option>
                          <option value="Gombe">Gombe</option>
                          <option value="Imo">Imo</option>
                          <option value="Jigawa">Jigawa</option>
                          <option value="Kaduna">Kaduna</option>
                          <option value="Kano">Kano</option>
                          <option value="Katsina">Katsina</option>
                          <option value="Kebbi">Kebbi</option>
                          <option value="Kogi">Kogi</option>
                          <option value="Kwara">Kwara</option>
                          <option value="Lagos">Lagos</option>
                          <option value="Nasarawa">Nasarawa</option>
                          <option value="Niger">Niger</option>
                          <option value="Ogun">Ogun</option>
                          <option value="Ondo">Ondo</option>
                          <option value="Osun">Osun</option>
                          <option value="Oyo">Oyo</option>
                          <option value="Plateau">Plateau</option>
                          <option value="Rivers">Rivers</option>
                          <option value="Sokoto">Sokoto</option>
                          <option value="Taraba">Taraba</option>
                          <option value="Yobe">Yobe</option>
                          <option value="Zamfara">Zamfara</option>
                        </select>
                      </div>
                    </div>
                    <div>
                      <label
                        class="block text-sm font-semibold text-gray-700 mb-1"
                        >University</label
                      >
                      <div class="relative">
                        <input
                          type="text"
                          id="signupUniversity"
                          placeholder="e.g. University of Lagos"
                          class="w-full border border-gray-300 dark:border-gray-600 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none bg-white dark:bg-gray-700 text-gray-900 dark:text-white"
                        />
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Role Toggle -->
                <div id="roleGroup" class="pt-4 border-t border-gray-100">
                  <label class="block text-sm font-semibold text-gray-700 mb-3"
                    >What brings you here?</label
                  >
                  <div class="grid grid-cols-2 gap-4">
                    <label class="cursor-pointer">
                      <input
                        type="radio"
                        name="role"
                        value="client"
                        class="peer sr-only"
                        checked
                      />
                      <div
                        class="border-2 border-gray-200 rounded-xl p-4 text-center peer-checked:border-orange-600 peer-checked:bg-orange-50 transition"
                      >
                        <svg
                          class="w-6 h-6 mx-auto mb-2 text-gray-500 peer-checked:text-orange-600"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                          ></path>
                        </svg>
                        <div
                          class="font-bold text-gray-800 peer-checked:text-orange-700"
                        >
                          Hire a Service
                        </div>
                        <div class="text-xs text-gray-500 mt-1">
                          I want to find skills
                        </div>
                      </div>
                    </label>
                    <label class="cursor-pointer">
                      <input
                        type="radio"
                        name="role"
                        value="provider"
                        class="peer sr-only"
                      />
                      <div
                        class="border-2 border-gray-200 rounded-xl p-4 text-center peer-checked:border-orange-600 peer-checked:bg-orange-50 transition"
                      >
                        <svg
                          class="w-6 h-6 mx-auto mb-2 text-gray-500 peer-checked:text-orange-600"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                          ></path>
                        </svg>
                        <div
                          class="font-bold text-gray-800 peer-checked:text-orange-700"
                        >
                          Offer a Service
                        </div>
                        <div class="text-xs text-gray-500 mt-1">
                          I want to work
                        </div>
                      </div>
                    </label>
                  </div>
                </div>

                <!-- Alerts -->
                <div id="modalAlerts" class="hidden">
                  <div
                    id="modal-alert-yellow"
                    class="hidden bg-yellow-50 border border-yellow-200 text-yellow-800 px-4 py-3 rounded-lg text-sm flex items-center"
                  >
                    <svg
                      class="w-5 h-5 mr-2 animate-spin text-yellow-500"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                    >
                      <circle
                        class="opacity-25"
                        cx="12"
                        cy="12"
                        r="10"
                        stroke="currentColor"
                        stroke-width="4"
                      ></circle>
                      <path
                        class="opacity-75"
                        fill="currentColor"
                        d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                      ></path>
                    </svg>
                    Processing AI Document Forensics...
                  </div>
                  <div
                    id="modal-alert-green"
                    class="hidden bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg text-sm flex items-center"
                  >
                    <svg
                      class="w-5 h-5 mr-2 text-green-500"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                      ></path>
                    </svg>
                    Identity Successfully Verified!
                  </div>
                  <div
                    id="modal-alert-red"
                    class="hidden bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg text-sm flex items-center"
                  >
                    <svg
                      class="w-5 h-5 mr-2 text-red-500"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                      ></path>
                    </svg>
                    Verification Flagged. Sent for manual review.
                  </div>
                </div>

                <!-- Submit -->
                <div class="pt-2">
                  <button
                    type="submit"
                    id="modalSubmitBtn"
                    class="w-full bg-orange-600 text-white py-3.5 rounded-xl font-bold text-base hover:bg-orange-700 transition disabled:opacity-70 disabled:cursor-not-allowed shadow-md flex justify-center items-center"
                  >
                    <span id="modalSubmitText">Create Account</span>
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Edit Profile Modal -->
    <div
      id="editProfileModal"
      class="relative z-50 hidden"
      aria-labelledby="modal-title"
      role="dialog"
      aria-modal="true"
    >
      <div
        id="editProfileModalBackdrop"
        class="fixed inset-0 transition-opacity bg-gray-900/60 backdrop-blur-sm"
        aria-hidden="true"
      ></div>

      <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
        <div
          class="flex min-h-full items-center justify-center p-4 text-center sm:p-0"
        >
          <div
            class="relative bg-white dark:bg-gray-800 rounded-2xl text-left overflow-hidden shadow-2xl transform transition-all sm:my-8 sm:max-w-2xl w-full"
          >
            <button
              id="closeEditProfileBtn"
              class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 focus:outline-none p-2 rounded-full hover:bg-gray-50 transition"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M6 18L18 6M6 6l12 12"
                />
              </svg>
            </button>

            <div class="px-6 py-8 sm:p-10">
              <div class="mb-8">
                <h3 class="text-2xl font-bold text-gray-900 dark:text-white">
                  Edit Provider Profile
                </h3>
                <p class="text-sm text-gray-500">
                  Update your details and services for potential clients.
                </p>
              </div>

              <form id="editProfileForm" class="space-y-6">
                <!-- Cover Image & Avatar -->
                <div class="space-y-4">
                  <div>
                    <label
                      class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
                      >Cover Image</label
                    >
                    <input
                      type="file"
                      accept="image/*"
                      id="editCoverFile"
                      class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 text-gray-900 dark:text-white rounded-xl focus:ring-2 focus:ring-orange-500 focus:bg-white transition outline-none text-sm text-gray-900"
                    />
                  </div>
                  <div>
                    <label
                      class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
                      >Avatar Image</label
                    >
                    <input
                      type="file"
                      accept="image/*"
                      id="editAvatarFile"
                      class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 text-gray-900 dark:text-white rounded-xl focus:ring-2 focus:ring-orange-500 focus:bg-white transition outline-none text-sm text-gray-900"
                    />
                  </div>
                </div>

                <!-- Basic Info -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                  <div>
                    <label
                      class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
                      >Location</label
                    >
                    <input
                      type="text"
                      id="editLocation"
                      class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 text-gray-900 dark:text-white rounded-xl focus:ring-2 focus:ring-orange-500 focus:bg-white transition outline-none text-sm"
                      placeholder="e.g. UniPort, Choba"
                    />
                  </div>
                  <div>
                    <label
                      class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
                      >Contact Number</label
                    >
                    <input
                      type="text"
                      id="editContact"
                      class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 text-gray-900 dark:text-white rounded-xl focus:ring-2 focus:ring-orange-500 focus:bg-white transition outline-none text-sm"
                      placeholder="08012345678"
                    />
                  </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label
                      class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
                      >Display Name</label
                    >
                    <input
                      type="text"
                      id="editDisplayName"
                      class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 text-gray-900 dark:text-white rounded-xl focus:ring-2 focus:ring-orange-500 focus:bg-white transition outline-none text-sm text-gray-900"
                      required
                    />
                  </div>
                  <div>
                    <label
                      class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
                      >Service Title</label
                    >
                    <input
                      type="text"
                      id="editServiceTitle"
                      placeholder="e.g. Braids & Nails Expert"
                      class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 text-gray-900 dark:text-white rounded-xl focus:ring-2 focus:ring-orange-500 focus:bg-white transition outline-none text-sm text-gray-900"
                      required
                    />
                  </div>
                </div>

                <!-- Location Info -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label
                      class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
                      >State</label
                    >
                    <div class="relative">
                      <select
                        id="editState"
                        class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 text-gray-900 dark:text-white rounded-xl focus:ring-2 focus:ring-orange-500 focus:bg-white dark:focus:bg-gray-600 transition outline-none text-sm appearance-none cursor-pointer"
                        required
                      >
                        <option value="">Select State</option>
                        <option value="Abia">Abia</option>
                        <option value="Adamawa">Adamawa</option>
                        <option value="Akwa Ibom">Akwa Ibom</option>
                        <option value="Anambra">Anambra</option>
                        <option value="Bauchi">Bauchi</option>
                        <option value="Bayelsa">Bayelsa</option>
                        <option value="Benue">Benue</option>
                        <option value="Borno">Borno</option>
                        <option value="Cross River">Cross River</option>
                        <option value="Delta">Delta</option>
                        <option value="Ebonyi">Ebonyi</option>
                        <option value="Edo">Edo</option>
                        <option value="Ekiti">Ekiti</option>
                        <option value="Enugu">Enugu</option>
                        <option value="FCT - Abuja">FCT - Abuja</option>
                        <option value="Gombe">Gombe</option>
                        <option value="Imo">Imo</option>
                        <option value="Jigawa">Jigawa</option>
                        <option value="Kaduna">Kaduna</option>
                        <option value="Kano">Kano</option>
                        <option value="Katsina">Katsina</option>
                        <option value="Kebbi">Kebbi</option>
                        <option value="Kogi">Kogi</option>
                        <option value="Kwara">Kwara</option>
                        <option value="Lagos">Lagos</option>
                        <option value="Nasarawa">Nasarawa</option>
                        <option value="Niger">Niger</option>
                        <option value="Ogun">Ogun</option>
                        <option value="Ondo">Ondo</option>
                        <option value="Osun">Osun</option>
                        <option value="Oyo">Oyo</option>
                        <option value="Plateau">Plateau</option>
                        <option value="Rivers">Rivers</option>
                        <option value="Sokoto">Sokoto</option>
                        <option value="Taraba">Taraba</option>
                        <option value="Yobe">Yobe</option>
                        <option value="Zamfara">Zamfara</option>
                      </select>
                      <div
                        class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none text-gray-500"
                      >
                        <svg
                          class="w-4 h-4"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 9l-7 7-7-7"
                          ></path>
                        </svg>
                      </div>
                    </div>
                  </div>
                  <div>
                    <label
                      class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
                      >University</label
                    >
                    <div class="relative">
                      <input
                        type="text"
                        id="editUniversity"
                        placeholder="e.g. University of Lagos"
                        class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 text-gray-900 dark:text-white rounded-xl focus:ring-2 focus:ring-orange-500 focus:bg-white dark:focus:bg-gray-600 transition outline-none text-sm"
                        required
                      />
                      <div
                        class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none text-gray-500"
                      >
                        <svg
                          class="w-4 h-4"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 9l-7 7-7-7"
                          ></path>
                        </svg>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Bio -->
                <div>
                  <label
                    class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
                    >Bio</label
                  >
                  <textarea
                    id="editBio"
                    rows="3"
                    class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 text-gray-900 dark:text-white rounded-xl focus:ring-2 focus:ring-orange-500 focus:bg-white transition outline-none text-sm text-gray-900"
                    placeholder="Tell clients about yourself..."
                    required
                  ></textarea>
                </div>

                <!-- Services (Simplified) -->
                <div>
                  <label
                    class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
                    >Service Settings</label
                  >
                  <div class="space-y-3">
                    <input
                      type="text"
                      id="editServiceName"
                      class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 text-gray-900 dark:text-white rounded-xl focus:ring-2 focus:ring-orange-500 transition outline-none text-sm"
                      placeholder="Service name"
                    />
                    <input
                      type="text"
                      id="editServiceDescription"
                      class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 text-gray-900 dark:text-white rounded-xl focus:ring-2 focus:ring-orange-500 transition outline-none text-sm"
                      placeholder="Short description"
                    />
                    <input
                      type="number"
                      id="editServicePrice"
                      class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 text-gray-900 dark:text-white rounded-xl focus:ring-2 focus:ring-orange-500 transition outline-none text-sm"
                      placeholder="Price (₦)"
                    />
                  </div>
                </div>

                <!-- Availability -->
                <div>
                  <label
                    class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
                    >Availability & Policies</label
                  >
                  <textarea
                    id="editAvailability"
                    rows="3"
                    class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 text-gray-900 dark:text-white rounded-xl focus:ring-2 focus:ring-orange-500 focus:bg-white transition outline-none text-sm text-gray-900"
                    placeholder="e.g. Mon-Fri 4PM-8PM
Cash only"
                    required
                  ></textarea>
                </div>

                <div class="pt-4 flex justify-end">
                  <button
                    type="button"
                    id="cancelEditProfileBtn"
                    class="mr-3 px-6 py-2.5 rounded-xl font-bold text-gray-700 bg-gray-100 hover:bg-gray-200 transition"
                  >
                    Cancel
                  </button>
                  <button
                    type="submit"
                    class="px-6 py-2.5 rounded-xl font-bold text-gray-900 dark:text-white bg-orange-600 hover:bg-orange-700 shadow-md transition"
                  >
                    Save Profile
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Script -->
    <script type="module" src="/src/main.ts"></script>

    <!-- Verification Modal -->
    <div
      id="verificationModal"
      class="relative z-50 hidden"
      aria-labelledby="modal-title"
      role="dialog"
      aria-modal="true"
    >
      <div
        id="verificationModalBackdrop"
        class="fixed inset-0 transition-opacity bg-gray-900/60 backdrop-blur-sm"
        aria-hidden="true"
      ></div>

      <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
        <div
          class="flex min-h-full items-center justify-center p-4 text-center sm:p-0"
        >
          <div
            class="relative inline-block w-full max-w-md p-8 overflow-hidden text-left align-middle transition-all transform bg-white shadow-2xl rounded-3xl sm:my-8 animate-fade-in-up"
          >
            <button
              id="closeVerificationBtn"
              class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 focus:outline-none p-2 rounded-full hover:bg-gray-50 transition"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M6 18L18 6M6 6l12 12"
                />
              </svg>
            </button>

            <div class="mb-6 text-center">
              <div
                class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-orange-100 mb-4"
              >
                <svg
                  class="h-6 w-6 text-orange-600"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                  />
                </svg>
              </div>
              <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">
                Get Verified
              </h3>
              <p class="text-sm text-gray-500">
                Providers must upload their Admission Letter & School Fees
                Receipt for verification.
              </p>
            </div>

            <div class="space-y-4">
              <div
                class="border-2 border-dashed border-gray-300 rounded-xl p-6 text-center hover:bg-orange-50 hover:border-orange-400 transition cursor-pointer group bg-gray-50"
                id="verificationDropZone"
              >
                <div
                  class="bg-white border border-gray-200 w-10 h-10 rounded-full flex items-center justify-center mx-auto mb-2 group-hover:text-orange-600 transition shadow-sm"
                >
                  <svg
                    class="h-5 w-5 text-gray-400 group-hover:text-orange-600"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"
                    />
                  </svg>
                </div>
                <p class="text-sm text-gray-700 font-medium mb-1">
                  Drag and drop files here
                </p>
                <label
                  class="inline-block cursor-pointer text-orange-600 hover:text-orange-700 text-xs font-semibold mt-1"
                >
                  or browse files
                  <input
                    type="file"
                    id="verificationDocumentUpload"
                    class="hidden"
                    multiple
                    accept="image/*,application/pdf"
                  />
                </label>
              </div>

              <!-- Previews -->
              <div id="verificationFileList" class="space-y-2 mt-3"></div>

              <!-- Verification Alerts -->
              <div id="verificationAlerts" class="hidden mt-4 space-y-2">
                <div
                  id="verif-alert-yellow"
                  class="hidden bg-yellow-50 border border-yellow-200 text-yellow-800 px-4 py-3 rounded-lg text-sm flex items-center"
                >
                  <svg
                    class="w-5 h-5 mr-2 animate-spin text-yellow-500"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                  >
                    <circle
                      class="opacity-25"
                      cx="12"
                      cy="12"
                      r="10"
                      stroke="currentColor"
                      stroke-width="4"
                    ></circle>
                    <path
                      class="opacity-75"
                      fill="currentColor"
                      d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                    ></path>
                  </svg>
                  Processing AI Document Forensics...
                </div>
                <div
                  id="verif-alert-green"
                  class="hidden bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg text-sm flex items-center"
                >
                  <svg
                    class="w-5 h-5 mr-2 text-green-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                    ></path>
                  </svg>
                  Identity Successfully Verified!
                </div>
                <div
                  id="verif-alert-red"
                  class="hidden bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg text-sm flex items-center"
                >
                  <svg
                    class="w-5 h-5 mr-2 text-red-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    ></path>
                  </svg>
                  Verification Flagged. Sent for manual review.
                </div>
              </div>

              <button
                id="verifySubmitBtn"
                class="w-full bg-gray-900 text-white font-semibold rounded-lg px-4 py-3 hover:bg-gray-800 transition shadow-sm mt-4"
              >
                <span id="verifySubmitText">Submit for Verification</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Mobile Bottom Tab Bar -->
    <nav
      class="md:hidden fixed bottom-0 left-0 w-full bg-white dark:bg-gray-900 border-t border-gray-200 dark:border-gray-800 flex justify-around items-center pb-safe pt-2 px-2 z-50"
    >
      <button
        id="mobile-home"
        class="flex flex-col items-center p-2 text-orange-600"
      >
        <svg
          class="w-6 h-6 mb-1"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
          ></path>
        </svg>
        <span class="text-[10px] font-medium">Home</span>
      </button>
      <button
        id="mobile-search"
        class="flex flex-col items-center p-2 text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white"
      >
        <svg
          class="w-6 h-6 mb-1"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
          ></path>
        </svg>
        <span class="text-[10px] font-medium">Search</span>
      </button>
      <button
        id="mobile-post"
        class="flex flex-col items-center p-2 text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white"
      >
        <div
          class="bg-orange-600 text-white rounded-full p-1.5 -mt-4 shadow-lg border-4 border-white dark:border-gray-900"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 4v16m8-8H4"
            ></path>
          </svg>
        </div>
        <span class="text-[10px] font-medium mt-0.5">Post</span>
      </button>
      <button
        id="mobile-requests"
        class="flex flex-col items-center p-2 text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white"
      >
        <svg
          class="w-6 h-6 mb-1"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"
          ></path>
        </svg>
        <span class="text-[10px] font-medium">Requests</span>
      </button>
      <button
        id="mobile-profile"
        class="flex flex-col items-center p-2 text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white"
      >
        <svg
          class="w-6 h-6 mb-1"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
          ></path>
        </svg>
        <span class="text-[10px] font-medium">Profile</span>
      </button>
    </nav>

    <!-- Toast Notification Container -->
    <div
      id="toastContainer"
      class="fixed bottom-4 right-4 z-[9999] flex flex-col gap-2 pointer-events-none"
    ></div>

    <!-- Booking Modal -->
    <div id="bookingModal" class="hidden fixed inset-0 z-50 overflow-y-auto">
      <div
        class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:p-0"
      >
        <div
          class="fixed inset-0 transition-opacity bg-gray-900/75 backdrop-blur-sm"
          aria-hidden="true"
          onclick="
            document.getElementById('bookingModal').classList.add('hidden')
          "
        ></div>
        <div
          class="relative inline-block overflow-hidden text-left align-bottom transition-all transform bg-white dark:bg-gray-900 rounded-3xl shadow-2xl sm:my-8 sm:align-middle sm:max-w-md w-full border border-gray-100 dark:border-gray-800"
        >
          <div class="px-6 py-6 md:px-8">
            <div class="flex justify-between items-center mb-6">
              <h3 class="text-2xl font-bold text-gray-900 dark:text-white">
                Request Service
              </h3>
              <button
                onclick="
                  document
                    .getElementById('bookingModal')
                    .classList.add('hidden')
                "
                class="text-gray-400 hover:text-gray-500 focus:outline-none"
              >
                <svg
                  class="w-6 h-6"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M6 18L18 6M6 6l12 12"
                  ></path>
                </svg>
              </button>
            </div>
            <form id="bookingForm" class="space-y-4">
              <div>
                <label
                  class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1"
                  >Service Name</label
                >
                <input
                  type="text"
                  id="bookingServiceName"
                  class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none"
                  required
                />
              </div>
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label
                    class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1"
                    >Date</label
                  >
                  <input
                    type="date"
                    id="bookingDate"
                    class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none"
                    required
                  />
                </div>
                <div>
                  <label
                    class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1"
                    >Time</label
                  >
                  <input
                    type="time"
                    id="bookingTime"
                    class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none"
                    required
                  />
                </div>
              </div>
              <div>
                <label
                  class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1"
                  >Additional Details</label
                >
                <textarea
                  id="bookingDetails"
                  rows="3"
                  class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none"
                  placeholder="e.g., location, specific requests..."
                ></textarea>
              </div>
              <button
                type="submit"
                class="w-full bg-orange-600 hover:bg-orange-700 text-white font-bold py-3 px-4 rounded-xl shadow-md transition transform hover:scale-[1.02] mt-4"
              >
                Send Request
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
