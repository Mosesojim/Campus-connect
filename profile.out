      <!-- How CampusConnect Works -->
      <section
        id="how-it-works"
        class="py-24 px-6 max-w-7xl mx-auto scroll-section opacity-0 translate-y-8 transition-all duration-700 ease-out"
      >
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center mb-16">
          <!-- Image on left -->
          <div
            class="relative w-full h-[300px] md:h-[400px] rounded-3xl overflow-hidden shadow-lg"
          >
            <img
              src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80"
              alt="Students connecting on campus"
              class="w-full h-full object-cover"
            />
          </div>

          <!-- Content on right -->
          <div class="text-left">
            <h2
              class="text-3xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6"
            >
              How CampusConnect works
            </h2>
            <p class="text-gray-600 dark:text-gray-400 text-lg leading-relaxed">
              A simple, secure, and student-only ecosystem designed to make
              campus life easier. Whether you are looking for a service or
              offering one, getting started is seamless.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
          <!-- Connector line -->
          <div
            class="hidden md:block absolute top-1/2 left-0 w-full h-0.5 bg-gray-200 dark:bg-gray-700 -translate-y-1/2 z-0"
          ></div>

          <!-- Step 1 -->
          <div
            class="relative z-10 bg-white dark:bg-gray-800 rounded-3xl p-10 border border-gray-100 dark:border-gray-700 shadow-sm hover:shadow-xl hover:-translate-y-2 transition-all duration-300 flex flex-col h-full scroll-section opacity-0 translate-y-8 transition-all duration-700 ease-out"
            style="transition-delay: 100ms"
          >
            <div
              class="w-20 h-20 bg-orange-100 dark:bg-orange-900/30 text-orange-600 dark:text-orange-500 text-4xl font-bold rounded-3xl flex items-center justify-center mb-8 shadow-sm mx-auto"
            >
              1
            </div>
            <h3
              class="font-bold text-gray-900 dark:text-white text-2xl mb-6 text-center"
            >
              Sign up & Verify
            </h3>
            <p
              class="text-gray-600 dark:text-gray-400 text-base leading-relaxed text-center mb-8 flex-grow"
            >
              Join using your student details. Upload your school ID or
              admission letter, and our AI verification system approves your
              profile instantly.
            </p>
            <ul class="text-sm text-gray-500 dark:text-gray-400 space-y-4">
              <li class="flex items-center justify-center">
                <svg
