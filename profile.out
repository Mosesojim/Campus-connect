<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <script type="module" src="/@vite/client"></script>

    <base href="/" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CampusConnect - Skill-Trade & Micro-Task Marketplace</title>
    <link rel="stylesheet" href="/src/style.css" />
  </head>
  <body
    class="bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 antialiased min-h-screen flex flex-col font-sans transition-colors duration-300"
  >
    <!-- Navbar -->
    <nav
      class="bg-white/90 dark:bg-gray-900/90 backdrop-blur-md py-4 px-6 md:px-12 flex justify-between items-center sticky top-0 z-40 border-b border-gray-100 dark:border-gray-800 transition-colors duration-300"
    >
      <div class="flex items-center space-x-2">
        <div
          class="bg-orange-600 text-white rounded-full w-8 h-8 flex items-center justify-center font-bold text-sm shadow-sm"
        >
          C
        </div>
        <div
          class="text-xl font-bold tracking-tight text-gray-900 dark:text-white"
        >
          Campus<span class="text-orange-600">Connect</span>
        </div>
      </div>
      <div
        class="hidden md:flex items-center space-x-4 lg:space-x-6 text-sm font-medium text-gray-600 dark:text-gray-300 flex-1 justify-center"
      >
        <a
          href="#services"
          class="hover:text-gray-900 dark:hover:text-white transition whitespace-nowrap"
          >Find Services</a
        >
        <a
          href="#provider"
          class="hover:text-gray-900 dark:hover:text-white transition whitespace-nowrap"
          >Become a Provider</a
        >
        <a
          href="#how-it-works"
          class="hover:text-gray-900 dark:hover:text-white transition whitespace-nowrap"
          >How It Works</a
        >

        <form
          id="navSearchForm"
          action="#"
          class="relative ml-4 flex-1 max-w-sm"
        >
          <button
            type="submit"
            class="absolute inset-y-0 left-0 pl-3 flex items-center hover:text-orange-600 transition z-10 cursor-pointer"
          >
            <svg
              class="h-4 w-4 text-gray-400 hover:text-orange-500"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
              />
            </svg>
          </button>
          <input
            type="text"
            id="navSearchInput"
            placeholder="Search tutors, designers..."
            class="bg-gray-50 border border-gray-200 text-gray-900 text-sm rounded-full focus:ring-orange-500 focus:border-orange-500 block w-full pl-10 p-2 dark:bg-gray-800 dark:border-gray-700 dark:text-white min-w-[200px]"
          />
        </form>
      </div>
      <div class="hidden md:flex items-center space-x-4">
        <button
          id="themeToggleBtn"
          class="mr-2 p-2 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-600 dark:text-gray-500 dark:text-gray-300 transition-colors focus:outline-none"
        >
          <svg
            id="themeIconDark"
            class="w-5 h-5 hidden"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
            ></path>
          </svg>
          <svg
            id="themeIconLight"
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
            ></path>
          </svg>
        </button>
        <div id="authContainer">
          <button
            id="openModalBtn"
            class="bg-orange-600 text-white px-5 py-2.5 rounded-full font-semibold text-sm hover:bg-orange-700 transition shadow-sm"
          >
            Sign Up / Login
          </button>
        </div>

        <div id="profileContainer" class="hidden relative">
          <button
            id="profileBtn"
            class="flex items-center space-x-2 text-gray-700 hover:text-orange-600 focus:outline-none transition group"
          >
            <div
              class="w-9 h-9 rounded-full bg-gray-100 flex items-center justify-center border border-gray-200 group-hover:border-orange-200 transition"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                ></path>
              </svg>
            </div>
            <span class="text-sm font-semibold hidden lg:block" id="profileName"
              >Profile</span
            >
            <span id="profileBadgeDesktop" class="hidden">
              <svg
                class="w-4 h-4 text-green-500"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                ></path>
              </svg>
            </span>
          </button>

          <div
            id="profileDropdown"
            class="hidden absolute right-0 mt-2 w-56 bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-xl shadow-lg py-1 z-50"
          >
            <div
              class="px-4 py-3 border-b border-gray-100 dark:border-gray-800"
            >
              <p
                class="text-sm font-bold text-gray-900 dark:text-white break-words"
                id="dropdownName"
              >
                User
              </p>
              <p
                class="text-xs text-gray-500 dark:text-gray-400 break-all"
                id="dropdownEmail"
              >
                user@example.com
              </p>
            </div>

            <div id="dropdownLinksContainer"></div>
            <button
              id="logoutBtn"
              class="w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-gray-50 dark:hover:bg-gray-800 transition"
            >
              Log out
            </button>
          </div>
        </div>
      </div>
      <!-- Mobile menu button -->
      <div class="md:hidden flex items-center">
        <button
          id="mobileMenuBtn"
          class="text-gray-600 hover:text-gray-900 focus:outline-none p-2"
        >
          <svg
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>
        </button>
      </div>
    </nav>

    <!-- Mobile Menu -->
    <div
      id="mobileMenu"
      class="hidden md:hidden bg-white/95 dark:bg-gray-900/95 backdrop-blur-md border-b border-gray-100 dark:border-gray-800 px-6 py-4 fixed w-full z-30 shadow-lg mt-[73px] top-0 left-0 transition-colors duration-300"
    >
      <div class="flex flex-col space-y-4">
        <a
          href="#hero"
          class="mobile-link block text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white font-medium"
          >Home</a
        >
        <a
          href="#services"
          class="mobile-link block text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white font-medium"
          >Find Services</a
        >
        <a
          href="#provider"
          class="mobile-link block text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white font-medium"
          >Become a Provider</a
        >
        <a
          href="#how-it-works"
          class="mobile-link block text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white font-medium"
          >How It Works</a
        >
        <div id="authContainerMobile">
          <button
            id="openModalBtnMobile"
            class="bg-orange-600 text-white px-5 py-2.5 rounded-full font-semibold text-sm hover:bg-orange-700 transition shadow-sm w-full text-center"
          >
            Sign Up / Login
          </button>
        </div>

        <div id="profileContainerMobile" class="!hidden hidden">
          <div
            class="px-5 py-3 border border-gray-100 rounded-xl mb-2 bg-gray-50 flex items-center justify-between"
          >
            <div class="flex items-center space-x-2">
              <div
                class="w-8 h-8 rounded-full bg-white flex items-center justify-center border border-gray-200"
              >
                <svg
                  class="w-4 h-4 text-gray-500"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                  ></path>
                </svg>
              </div>
              <div>
                <div
                  class="text-sm font-bold text-gray-900 flex items-center space-x-1"
                >
                  <span id="profileNameMobile">My Profile</span>
                  <span id="profileBadgeMobile" class="hidden">
                    <svg
                      class="w-4 h-4 text-green-500"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                      ></path>
                    </svg>
                  </span>
                </div>
                <div
                  class="text-xs text-gray-500"
                  id="dropdownEmailMobile"
                ></div>
              </div>
            </div>
          </div>

          <div id="mobileLinksContainer"></div>
          <button
            id="logoutBtnMobile"
            class="bg-red-50 text-red-600 px-5 py-2.5 rounded-full font-semibold text-sm hover:bg-red-100 transition shadow-sm w-full text-center flex items-center justify-center space-x-2"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
              ></path>
            </svg>
            <span>Log Out</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <main class="flex-grow">
      <!-- Search Results Section (Hidden by default) -->
      <section
        id="search-results-section"
        class="hidden py-10 px-6 max-w-6xl mx-auto scroll-section opacity-0 translate-y-8 transition-all duration-700 ease-out"
      >
        <div class="flex justify-between items-center mb-8">
          <button
            id="backFromSearchBtn"
            class="flex items-center text-gray-500 hover:text-gray-900 font-medium transition"
          >
            <svg
              class="w-5 h-5 mr-1"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 19l-7-7m0 0l7-7m-7 7h18"
              ></path>
            </svg>
            Back to home
          </button>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
            Search Results
          </h2>
        </div>

        <div
          id="searchResultsCount"
          class="text-gray-500 mb-6 font-medium"
        ></div>

        <div
          id="searchResultsContainer"
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
        >
          <!-- Search results will be injected here -->
        </div>

        <div
          id="noResultsNotice"
          class="hidden flex-col items-center justify-center py-20 bg-gray-50 rounded-2xl border border-gray-100"
        >
          <svg
            class="w-16 h-16 text-gray-400 mb-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
            ></path>
          </svg>
          <h3 class="text-xl font-bold text-gray-900 mb-2">No results found</h3>
          <p class="text-gray-500 text-center max-w-md">
            We couldn't find any providers matching your search. Try adjusting
            your keywords.
          </p>
        </div>
      </section>

      <!-- Provider Profile Section (Hidden by default) -->
      <section
        id="provider-profile-section"
        class="hidden py-10 px-6 max-w-5xl mx-auto scroll-section opacity-0 translate-y-8 transition-all duration-700 ease-out"
      >
        <button
          id="backToHomeBtn"
          class="flex items-center text-gray-500 hover:text-gray-900 mb-8 font-medium transition"
        >
          <svg
            class="w-5 h-5 mr-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"
            ></path>
          </svg>
          Back to home
        </button>

        <div
          class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden"
        >
          <!-- Cover & Profile Image -->
          <div
            class="h-48 bg-cover bg-center relative"
            id="profileCoverImage"
            
          >
            <div
              class="absolute -bottom-12 left-8 border-4 border-white rounded-full overflow-hidden w-24 h-24 bg-gray-200"
            >
              <img
                referrerpolicy="no-referrer"
                id="profileAvatar"
                src=""
                alt="Provider"
                class="w-full h-full object-cover"
              />
            </div>
          </div>

          <div
            class="pt-16 pb-8 px-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-6"
          >
            <div>
              <div class="flex items-center space-x-3 mb-1">
                <h1 class="text-3xl font-bold text-gray-900" id="profileNameDisplay"></h1>
                <span
                  class="bg-green-50 text-green-700 text-[10px] font-bold px-2 py-1 rounded border border-green-200 flex items-center"
                >
                  <svg
                    class="w-3 h-3 mr-1"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"
                    ></path>
                  </svg>
                  VERIFIED STUDENT
                </span>
              </div>
              <p class="text-lg text-gray-500 dark:text-gray-400 mb-2" id="profileServiceType"></p>
              <div class="flex items-center text-sm text-gray-600 space-x-4">
                <div
                  class="flex items-center text-yellow-400 hidden"
                  id="profileRatingContainer"
                ></div>
                <div class="flex items-center">
                  <svg
                    class="w-4 h-4 mr-1 text-gray-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                    ></path>
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                    ></path>
                  </svg>
                  <span id="profileLocationDisplay">Not specified</span>
                </div>
              </div>
            </div>

            <button
              id="hireMeBtn"
              class="bg-orange-600 hover:bg-orange-700 text-white font-bold py-3 px-8 rounded-full shadow-md transition transform hover:scale-105 flex items-center"
            >
              <svg
                class="w-5 h-5 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
              Hire Me
            </button>
          </div>

          <div class="border-t border-gray-100">
            <div
              class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-gray-100"
            >
              <!-- About -->
              <div class="p-8 md:col-span-2">
                <h3 class="text-xl font-bold text-gray-900 mb-4">About Me</h3>
                <p class="text-gray-600 leading-relaxed mb-6" id="profileBio"></p>

                <h3 class="text-xl font-bold text-gray-900 mb-4">
                  Services & Pricing
                </h3>
                <div class="space-y-4" id="profileServicesList"></div>
              </div>

              <!-- Quick Info & Availability -->
              <div class="p-8 bg-gray-50">
                <h3 class="text-lg font-bold text-gray-900 mb-4">
                  Availability
                </h3>
                <ul class="space-y-3 mb-8" id="profileAvailabilityList"></ul>

                <h3 class="text-lg font-bold text-gray-900 mb-4">Policies</h3>
                <ul
                  class="space-y-3 text-sm text-gray-600"
                  id="profilePoliciesList"
                ></ul>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Hero Section -->
      <section
        id="hero"
        class="relative bg-white dark:bg-gray-900 pt-8 pb-12 md:pt-12 md:pb-16 px-6 text-center border-b border-orange-100 dark:border-gray-800 overflow-hidden transition-colors duration-300"
      >
        <!-- Background Image with Overlay -->
        <div
          class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1523050854058-8df90110c9f1?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80')] bg-cover bg-center bg-fixed z-0 opacity-40 dark:opacity-20"
        ></div>
        <div
          class="absolute inset-0 bg-white/90 dark:bg-gray-900/90 backdrop-blur-sm z-0"
        ></div>

        <!-- Decorative blobs -->
        <div
          class="absolute top-0 left-0 w-64 h-64 bg-orange-300/30 dark:bg-orange-600/20 rounded-full mix-blend-multiply dark:mix-blend-lighten filter blur-3xl opacity-70 animate-pulse-soft z-0"
        ></div>
        <div
          class="absolute bottom-0 right-0 w-80 h-80 bg-yellow-300/30 dark:bg-yellow-600/20 rounded-full mix-blend-multiply dark:mix-blend-lighten filter blur-3xl opacity-70 animate-pulse-soft z-0"
          style="animation-delay: 1.5s"
        ></div>

        <div class="max-w-4xl mx-auto relative z-10">
          <div
            class="inline-flex items-center space-x-2 bg-white/80 dark:bg-white/10 backdrop-blur-md border border-gray-200 dark:border-white/20 rounded-full px-4 py-1.5 mb-2 shadow-sm"
          >
            <span
              class="w-2 h-2 rounded-full bg-orange-500 shadow-[0_0_8px_rgba(249,115,22,0.8)]"
            ></span>
            <span
              class="text-xs font-medium text-gray-800 dark:text-white tracking-wide"
              >Verified students only</span
            >
          </div>
          <!-- Hero Carousel -->
          <div class="relative w-full overflow-visible mb-2">
            <div
              id="hero-carousel"
              class="flex overflow-x-auto overflow-y-hidden items-center snap-x snap-mandatory no-scrollbar scroll-smooth"
            >
              <!-- Slide 1 -->
              <div
                class="w-full shrink-0 snap-center flex flex-col items-center justify-center transition-all duration-300"
              >
                <h1
                  class="text-5xl md:text-6xl font-extrabold text-gray-900 dark:text-white tracking-tight mb-2 leading-tight drop-shadow-md scroll-section opacity-0 translate-y-8 transition-all duration-700 ease-out"
                >
                  Find the Best
                  <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-yellow-300"
                    >Skills</span
                  ><br class="hidden md:block" />
                  <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-orange-500 to-amber-500"
                    >on Campus</span
                  >
                </h1>
                <p
                  class="text-lg text-gray-600 dark:text-gray-500 dark:text-gray-300 max-w-2xl mx-auto leading-relaxed px-4 md:px-0 drop-shadow-sm scroll-section opacity-0 translate-y-8 transition-all duration-700 ease-out"
                  style="transition-delay: 100ms"
                >
                  Hire trusted student providers for hair, gadget repair,
                  tutoring, fashion and errands all in one localized
                  marketplace.
                </p>
              </div>

              <!-- Slide 2 -->
              <div
                class="w-full shrink-0 snap-center flex flex-col items-center justify-center transition-all duration-300"
              >
                <h1
                  class="text-5xl md:text-6xl font-extrabold text-gray-900 dark:text-white tracking-tight mb-2 leading-tight drop-shadow-md scroll-section opacity-0 translate-y-8 transition-all duration-700 ease-out"
                >
                  Find the Best
                  <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-300"
                    >Tutors</span
                  ><br class="hidden md:block" />
                  <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-orange-500 to-amber-500"
                    >on Campus</span
                  >
                </h1>
                <p
                  class="text-lg text-gray-600 dark:text-gray-500 dark:text-gray-300 max-w-2xl mx-auto leading-relaxed px-4 md:px-0 drop-shadow-sm scroll-section opacity-0 translate-y-8 transition-all duration-700 ease-out"
                  style="transition-delay: 100ms"
                >
                  Ace your exams with the best peer tutors. Get help in Math,
                  Science, and more right on your campus.
                </p>
              </div>

              <!-- Slide 3 -->
              <div
                class="w-full shrink-0 snap-center flex flex-col items-center justify-center transition-all duration-300"
              >
                <h1
                  class="text-5xl md:text-6xl font-extrabold text-gray-900 dark:text-white tracking-tight mb-2 leading-tight drop-shadow-md scroll-section opacity-0 translate-y-8 transition-all duration-700 ease-out"
                >
                  Find the Best
                  <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-pink-400 to-purple-300"
                    >Stylists</span
                  ><br class="hidden md:block" />
                  <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-orange-500 to-amber-500"
                    >on Campus</span
                  >
                </h1>
                <p
                  class="text-lg text-gray-600 dark:text-gray-500 dark:text-gray-300 max-w-2xl mx-auto leading-relaxed px-4 md:px-0 drop-shadow-sm scroll-section opacity-0 translate-y-8 transition-all duration-700 ease-out"
